---
import Layout from "../../layouts/Layout.astro";
import { AboutMe, Proyects, UserBolt } from "../../icons";
import SectionContainer from "../../components/SectionContainer.astro";
import Projects from "../../components/Projects.astro";
import Profile from "../../components/Profile.astro";
import TitleSection from "../../components/TitleSection.astro";
import Experience from "../../components/Experience.astro";
import AboutMeComponent from "../../components/AboutMeComponent.astro";
import { getLangFromUrl, useTranslations } from "../../i18n/utils";
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<Layout
  title="Portafolio de Juan Diego - Desarrollador FullStack"
  description="Programador Frontend y Backend con conocimientos en C# .NET y JavaScript/TypeScript"
>
  <main class="px-4 sm:px-6 min-h-screen">
    <SectionContainer class="py-16 sm:py-20 md:py-36">
      <Profile />
    </SectionContainer>
    <div class="space-y-24">
      <SectionContainer id="experiencia">
        <TitleSection>
          <UserBolt class="size-" />
          {t("title.experience")}
        </TitleSection>
        <Experience />
      </SectionContainer>
      <SectionContainer id="proyectos">
        <TitleSection>
          <Proyects class="size-6" />
          {t("title.projects")}
        </TitleSection>
        <Projects />
      </SectionContainer>
      <SectionContainer id="sobre-mi">
        <TitleSection>
          <AboutMe class="size-6" />
          {t("title.about")}
        </TitleSection>
        <AboutMeComponent />
      </SectionContainer>
    </div>
  </main>
</Layout>
