---
const currentYear = new Date().getFullYear();
---

<footer
  class="max-w-4xl mx-auto mb-6 bg-[#ffff] dark:bg-[#171717] backdrop-blur-lg w-full"
>
  <div
    class="w-full mx-auto max-w-screen-xl p-4 flex flex-col md:flex-row md:items-center md:justify-between"
  >
    <span class="text-sm text-gray-500 text-center md:text-left mb-4 md:mb-0">
      <a href="https://diego.dev.com/" class="hover:underline"
        >juandiegc.dev - {currentYear}
      </a>
    </span>
    <ul
      class="flex flex-wrap items-center justify-center mt-1 mb-3 text-sm font-medium text-white/90 sm:mt-0"
    >
      <li>
        <a href="#" class="hover:text-[#c2ff52] me-4 md:me-6 text-gray-300"
          >Inicio</a
        >
      </li>
      <li>
        <a href="#" class="hover:text-[#c2ff52] text-gray-300">Contacto</a>
      </li>
    </ul>
  </div>
</footer>
