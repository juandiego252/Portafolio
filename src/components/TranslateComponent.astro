---
import { languagesList } from "../i18n/ui";
import { getLangFromUrl } from "../i18n/utils";
import { Lenguage } from "../icons";
const currentLang = getLangFromUrl(Astro.url);
const { pathname } = Astro.url;
---

<div class="relative inline-block">
    <button
        title="Change Language"
        id="dropdownDefaultButton"
        data-dropdown-toggle="dropdown"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md dark:text-gray-300 dark:hover:text-white transition-colors duration-300 text-black hover:text-neutral-400 cursor-pointer"
        type="button"
        aria-expanded="false"
    >
        <Lenguage class="h-[18px] w-[18px]" />
    </button>

    <!-- Dropdown menu -->
    <div
        id="dropdown"
        class="z-10 hidden absolute top-full right-0 mt-1 bg-white divide-y divide-gray-100 rounded-lg shadow-sm w-29 dark:bg-neutral-800"
    >
        <ul
            class="py-2 text-sm text-gray-700 dark:text-gray-200"
            aria-labelledby="dropdownDefaultButton"
        >
            {
                Object.entries(languagesList).map(([lang, label]) => {
                    const isActive = currentLang === lang;

                    // Crea la ruta correctamente
                    let path;

                    // Primero, determina si la URL actual ya tiene un prefijo de idioma
                    const hasLangPrefix = pathname.match(/^\/[a-z]{2}(?:\/|$)/);

                    if (lang === "en") {
                        // Para inglés (idioma predeterminado):
                        // Si hay prefijo de idioma, quítalo y deja el resto de la ruta
                        if (hasLangPrefix) {
                            path = pathname.replace(
                                /^\/[a-z]{2}(\/.*)?$/,
                                "$1",
                            );
                            if (path === "") path = "/";
                        } else {
                            // Ya está en una ruta sin prefijo (inglés)
                            path = pathname;
                        }
                    } else {
                        // Para español:
                        if (hasLangPrefix && pathname.startsWith(`/${lang}`)) {
                            // Ya está en la ruta del idioma correcto
                            path = pathname;
                        } else if (hasLangPrefix) {
                            // Tiene prefijo pero de otro idioma, reemplázalo
                            path = pathname.replace(
                                /^\/[a-z]{2}(\/.*)?$/,
                                `/${lang}$1`,
                            );
                        } else {
                            // No tiene prefijo (está en inglés), añade el prefijo
                            path = `/${lang}${pathname === "/" ? "" : pathname}`;
                        }
                    }

                    console.log(`Generando ruta para ${lang}: ${path}`);

                    return (
                        <li>
                            <a
                                href={path}
                                data-lang={lang}
                                class={`block w-full px-4 py-2 hover:bg-transparent dark:hover:bg-transparent dark:hover:text-white ${isActive ? "font-bold" : ""}`}
                            >
                                <img
                                    src={`/assets/flags/${lang === "en" ? "us" : "es"}.svg`}
                                    alt={label}
                                    class="size-5 rounded-full inline-block mr-2"
                                />
                                {label}
                            </a>
                        </li>
                    );
                })
            }
        </ul>
    </div>
</div>

<script>
    // Controla la apertura y cierre del dropdown
    document.addEventListener("DOMContentLoaded", function () {
        const dropdownButton = document.getElementById("dropdownDefaultButton");
        const dropdown = document.getElementById("dropdown");

        if (!dropdownButton || !dropdown) {
            console.error("No se encontraron los elementos del dropdown");
            return;
        }

        // Toggle dropdown al hacer click en el botón
        dropdownButton.addEventListener("click", function () {
            dropdown.classList.toggle("hidden");
            dropdownButton.setAttribute(
                "aria-expanded",
                dropdown.classList.contains("hidden") ? "false" : "true",
            );
        });

        // Cerrar dropdown cuando se hace click fuera
        document.addEventListener("click", function (e) {
            const target = e.target as Node;
            if (
                target &&
                !dropdownButton.contains(target) &&
                !dropdown.contains(target)
            ) {
                dropdown.classList.add("hidden");
                dropdownButton.setAttribute("aria-expanded", "false");
            }
        });

        // Manejo de selección de idioma
        const langButtons =
            dropdown.querySelectorAll<HTMLElement>("a[data-lang]");
        langButtons.forEach((button) => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                const lang = this.getAttribute("data-lang");
                const href = this.getAttribute("href");

                console.log("Idioma seleccionado:", lang);
                console.log("Navegando a:", href);

                // Implementación del cambio de idioma
                if (lang && href) {
                    // Guardar la preferencia del usuario
                    localStorage.setItem("preferredLanguage", lang);

                    // Navegar a la URL con el idioma seleccionado
                    window.location.href = href;
                }

                dropdown.classList.add("hidden");
            });
        });
    });
</script>
