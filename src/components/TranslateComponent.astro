---
import { Lenguage } from "../icons";
---

<div class="relative inline-block">
    <button
        id="dropdownDefaultButton"
        data-dropdown-toggle="dropdown"
        class="inline-flex h-9 w-9 items-center justify-center rounded-md dark:text-gray-300 dark:hover:text-white transition-colors duration-300 text-black hover:text-neutral-400"
        type="button"
        aria-expanded="false"
    >
        <Lenguage class="h-[18px] w-[18px]" />
    </button>

    <!-- Dropdown menu -->
    <div
        id="dropdown"
        class="z-10 hidden absolute top-full right-0 mt-1 bg-white divide-y divide-gray-100 rounded-lg shadow-sm w-29 dark:bg-neutral-800"
    >
        <ul
            class="py-2 text-sm text-gray-700 dark:text-gray-200"
            aria-labelledby="dropdownDefaultButton"
        >
            <li>
                <a
                    href="#"
                    data-lang="en"
                    class="block w-full px-4 py-2 hover:bg-transparent dark:hover:bg-transparent dark:hover:text-white"
                >
                    <img
                        src="/public/assets/flags/us.svg"
                        alt="English"
                        class="size-5 rounded-full inline-block mr-2"
                    />
                    English</a
                >
            </li>
            <li>
                <a
                    href="#"
                    data-lang="es"
                    class="block w-full px-4 py-2 hover:bg-transparent dark:hover:bg-transparent dark:hover:text-white"
                >
                    <img
                        src="/public/assets/flags/es.svg"
                        alt="English"
                        class="size-5 rounded-full inline-block mr-2"
                    />
                    Spanish</a
                >
            </li>
        </ul>
    </div>
</div>

<script>
    // Controla la apertura y cierre del dropdown
    document.addEventListener("DOMContentLoaded", function () {
        const dropdownButton = document.getElementById("dropdownDefaultButton");
        const dropdown = document.getElementById("dropdown");

        if (!dropdownButton || !dropdown) {
            console.error("No se encontraron los elementos del dropdown");
            return;
        }

        // Toggle dropdown al hacer click en el botón
        dropdownButton.addEventListener("click", function () {
            dropdown.classList.toggle("hidden");
            dropdownButton.setAttribute(
                "aria-expanded",
                dropdown.classList.contains("hidden") ? "false" : "true",
            );
        });

        // Cerrar dropdown cuando se hace click fuera
        document.addEventListener("click", function (e) {
            const target = e.target as Node;
            if (
                target &&
                !dropdownButton.contains(target) &&
                !dropdown.contains(target)
            ) {
                dropdown.classList.add("hidden");
                dropdownButton.setAttribute("aria-expanded", "false");
            }
        });

        // Manejo de selección de idioma
        const langButtons =
            dropdown.querySelectorAll<HTMLElement>("a[data-lang]");
        langButtons.forEach((button) => {
            button.addEventListener("click", function (e) {
                e.preventDefault();
                const lang = this.getAttribute("data-lang");
                console.log("Idioma seleccionado:", lang);
                // Implementación del cambio de idioma
                // localStorage.setItem('language', lang);
                dropdown.classList.add("hidden");
            });
        });
    });
</script>
