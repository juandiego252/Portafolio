---
import {
  getLangFromUrl,
  getLocalizedContent,
  useTranslations,
} from "../i18n/utils";
import { ArrowUpRight } from "../icons";

interface Props {
  role: {
    en: string;
    es: string;
  };
  aboutRole: {
    en: string;
    es: string;
  };
  company: string;
  companyUrl: string;
  datePeriod: {
    en: string;
    es: string;
  };
}
// Obtener el idioma actual y las traducciones
const lang = getLangFromUrl(Astro.url);
const { role, aboutRole, company, companyUrl, datePeriod } = Astro.props;
// Obtener el texto localizado para el rol y la descripción
const localizedRole = getLocalizedContent(role, lang);
const localizedAboutRole = getLocalizedContent(aboutRole, lang);
const localizedDate = getLocalizedContent(datePeriod, lang);
---

<li class="ms-5 mt-1">
  <div
    class="absolute -start-[6.5px] mt-2 h-3 w-3 rounded-full border border-neutral-500 dark:bg-[#d0ff0d] bg-neutral-200"
  >
  </div>
  <time class="mb-2 text-xs dark:text-white/80 leading-none text-neutral-600"
    >{localizedDate}</time
  >

  <div class="mt-2 flex flex-col space-y-0.5">
    <h3
      class="text-lg font-semibold tracking-tight dark:text-[#d0ff0d] text-black"
    >
      {localizedRole}
    </h3>
    <h4 class="text-xl text-white">
      <a
        href={companyUrl}
        target="_blank"
        rel="noopener"
        class="group flex w-max items-center text-pretty text-sm text-neutral-400 transition-colors duration-150 hover:text-gray-500"
      >
        <span>{company}</span>
        <ArrowUpRight
          class="size-3 ml-1 duration-150 group-hover:translate-x-[1.5px]"
        />
      </a>
    </h4>
  </div>
  <p class="mt-3 dark:text-neutral-400 text-sm text-pretty text-neutral-700">
    {localizedAboutRole}
  </p>
</li>
