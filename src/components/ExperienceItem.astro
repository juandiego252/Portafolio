---
import { ArrowUpRight } from "../icons";

interface Props {
  role: string;
  aboutRole: string;
  company: string;
  companyUrl: string;
  startDate: string;
  endDate: string;
  latest: boolean;
}

const { role, aboutRole, company, companyUrl, startDate, endDate, latest } =
  Astro.props;
---

<li class="ms-5 mt-1">
  <div
    class="absolute -start-[6.5px] mt-2 h-3 w-3 rounded-full border border-neutral-600 bg-[#d0ff0d]"
  >
  </div>
  <time class="mb-2 text-xs text-white/80 leading-none"
    >{startDate} - {endDate}</time
  >

  <div class="mt-2 flex flex-col space-y-0.5">
    <h3 class="text-lg font-semibold tracking-tight text-[#d0ff0d]">{role}</h3>
    <h4 class="font-semibold text-xl text-white">
      <a
        href={companyUrl}
        target="_blank"
        rel="noopener"
        class="group flex w-max items-center text-pretty text-sm text-neutral-400 transition-colors duration-150 hover:text-gray-500"
      >
        <span>{company}</span>
        <ArrowUpRight
          class="size-5 ml-1 duration-150 group-hover:translate-x-[1.5px]"
        />
      </a>
    </h4>
  </div>
  <p class="mt-3 text-neutral-400 text-sm text-pretty">
    {aboutRole}
  </p>
</li>
