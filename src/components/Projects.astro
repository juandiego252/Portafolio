---
import Card from "./Card.astro";
import {
  NextJS,
  Tailwind,
  React,
  NodeJS,
  AspNet,
  MongoDB,
} from "./icons/projects-icons";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  REACT: {
    name: "React",
    class: "bg-black text-white",
    icon: React,
  },
  TAILWIND: {
    name: "TailwindCSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  NODE: {
    name: "Node.js",
    class: "bg-gray-200 text-black",
    icon: NodeJS,
  },
  ASPNET: {
    name: "ASP.NET",
    class: "bg-gray-100/20 text-white",
    icon: AspNet,
  },
  MongoDB: {
    name: "Mongo DB",
    class: "bg-[#1e3137] text-white",
    icon: MongoDB,
  },
};
const PROJECTS = [
  {
    title: "Wallpapers - App",
    description:
      "Wallpapers App es una aplicación web diseñada para ofrecer una experiencia fluida y atractiva al buscar y descargar wallpapers de alta calidad. Con un diseño moderno y una interfaz intuitiva, los usuarios pueden explorar una amplia variedad de fondos de pantalla organizados en categorías.",
    link: "https://tabler.io/icons",
    github: "https://github.com/juandiego252/WallPapers-App.git",
    image: "/assets/projects-images/svgWallpapersApp.jpeg",
    tags: [TAGS.REACT, TAGS.TAILWIND, TAGS.MongoDB],
  },
  {
    title: "AdventJS",
    description:
      "Mollit cupidatat nulla sit irure fugiat enim sit ipsum. Lorem qui consectetur fugiat nisi duis non nulla enim eiusmod ad laborum. Voluptate culpa ipsum laborum magna eiusmod cillum nostrud ex officia. Commodo ex tempor cillum incididunt amet.",
    github: "https://github.com/tabler/tabler-icons",
    link: "https://adventjs.dev",
    image: "/assets/projects-images/svgProjectTwo.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.REACT, TAGS.NODE],
  },
];
---

<!-- {
  PROJECTS.map(({ title, description, image, tags }) => (
    <article>
      <h3 class="text-2xl font-semibold text-blue-200 mb-2">{title}</h3>
      <p class="text-lg mb-4 text-pretty">{description}</p>
      <img
        class="rounded shadow-2xl shadow-white/20"
        src={image}
        alt={`Captura del proyecto ${title}`}
      />
      <ul class="flex flex-row mb-2 gap-x-2 mt-2">
        {tags.map((tag) => (
          <li>
            <span
              class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
            >
              <tag.icon class="size-4" />
              {tag.name}
            </span>
          </li>
        ))}
      </ul>
    </article>
  ))
} -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
  {
    PROJECTS.map(({ title, description, image, tags, link, github }) => (
      <Card
        title={title}
        description={description}
        image={image}
        tags={tags}
        link={link}
        github={github}
      />
    ))
  }
</div>
