---
import Card from "./Card.astro";
import { Projects as PROJECTS } from "../data/projects.ts";
import ProjectCard from "./ProjectCard.astro";
---

<div class="flex flex-col gap-6 mt-10">
  {
    PROJECTS.map(
      (
        {
          id,
          title,
          description,
          image,
          favIcon,
          tags,
          link,
          github,
          updated,
          fullstack,
        },
        index,
      ) => (
        <ProjectCard
          id={id}
          title={title}
          description={description}
          favIcon={favIcon}
          image={image}
          tags={tags}
          link={link}
          github={github}
          updated={updated}
          fullstack={fullstack}
        />
      ),
    )
  }
</div>
