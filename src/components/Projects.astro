---
import Card from "./Card.astro";
import { Projects as PROJECTS } from "../data/projects.ts";
---
<div class="grid grid-cols-1 gap-3 md:grid-cols-2">
  {
    PROJECTS.map(
      ({
        title,
        description,
        image,
        tags,
        link,
        github,
        updated,
        fullstack,
      }) => (
        <Card
          title={title}
          description={description}
          image={image}
          tags={tags}
          link={link}
          github={github}
          updated={updated}
          fullstack={fullstack}
        />
      ),
    )
  }
</div>
