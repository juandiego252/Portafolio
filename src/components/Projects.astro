---
import Footer from "./Footer.astro";
import { NextJS, Tailwind, React } from "./icons/projects-icons";


const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  REACT: {
    name: "React",
    class: "bg-black text-white",
    icon: React,
  },
  TAILWIND: {
    name: "TailwindCSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
};
const PROJECTS = [
  {
    title: "Icons - Libraty",
    description: "Libreria de iconos SVG para tus proyectos",
    link: "https://tabler.io/icons",
    github: "https://github.com/tabler/tabler-icons",
    image: "/assets/projects-images/svgProjectOne.webp",
    tags: [TAGS.NEXT, TAGS.TAILWIND, TAGS.REACT],
  },
];
---

{
  PROJECTS.map(({ title, description, image, tags }) => (
    <article>
      <h3 class="text-2xl font-semibold text-blue-200 mb-2">{title}</h3>
      <p class="text-lg mb-4 text-pretty">{description}</p>
      <img
        class="rounded shadow-2xl shadow-white/35"
        src={image}
        alt={`Captura del proyecto ${title}`}
      />
      <ul class="flex flex-row mb-2 gap-x-2 mt-2">
        {tags.map((tag) => (
          <li>
            <span
              class={`flex gap-x-2 rounded-full text-xs ${tag.class} py-1 px-2`}
            >
              <tag.icon class="size-4" />
              {tag.name}
            </span>
          </li>
        ))}
      </ul>
    </article>
  ))
}
