---
const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre Mi",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
  // {
  //   title: "Contacto",
  //   label: "contacto",
  //   url: "/#contacto",
  // },
  // {
  //   title: "Inicio",
  //   label: "top",
  //   url: "/#top",
  // },
];
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 text-sm font-medium rounded-full text-gray-300 justify-center items-center"
  >
    {
      navItems.map(({ title, label, url }) => (
        <a
          class="relative block px-2 py-2 transition hover:text-[#c2ff52] [&.active]:text-[#c2ff52]"
          aria-label={label}
          href={url}
        >
          {title}
        </a>
      ))
    }
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section[data-section]");
    const navItems = document.querySelectorAll("header nav a");

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        const id = entry.target.getAttribute("id");
        if (!id) return;

        const navItem = document.querySelector(
          `header nav a[aria-label="${id}"]`,
        );

        if (entry.isIntersecting) {
          // Remove active class from all nav items
          navItems.forEach((item) => {
            item.classList.remove("text-[#c2ff52]");
            item.classList.remove("active");
          });

          // Add active class to current nav item
          navItem?.classList.add("text-[#c2ff52]");
          navItem?.classList.add("active");
        }
      });
    };

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "-20% 0px -20% 0px",
      threshold: 0.2,
    });

    sections.forEach((section) => {
      observer.observe(section);
    });

    return () => observer.disconnect();
  });
</script>
<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply bg-white/15;
  }

  @keyframes nav-shadown {
    0% {
      @apply dark:bg-gray-800/0 bg-white/0;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
