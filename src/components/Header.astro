---
const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
];
---

<header
  class="fixed top-0 z-10 flex items-center justify-center w-full mx-auto mt-2"
>
  <nav
    class="flex px-3 text-sm font-medium rounded-full text-gray-300 justify-center items-center navbar"
  >
    {
      navItems.map((link) => (
        <a
          class="relative block px-2 py-2 transition hover:text-[#c2ff52]"
          aria-label={link.label}
          href={link.url}
        >
          {link.title}
        </a>
      ))
    }
  </nav>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("[data-section]");
    const navItems = document.querySelectorAll("header nav a");

    // Funcion para actualizar la navegacion
    const updateNavigation = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          // Remover la clase activa de todos los items
          navItems.forEach((item) => item.classList.remove("text-[#c2ff52]"));

          // Obtener el item activo
          const activeId = entry.target.getAttribute("data-section");
          const activeNavItem = document.querySelector(
            `header nav a[aria-label=${activeId}]`,
          );
          activeNavItem?.classList.add("text-[#c2ff52]");
        }
      });
    };

    // Configuracion del IntersectionObserver
    const observer = new IntersectionObserver(updateNavigation, {
      root: null,
      rootMargin: "-50% 0px",
      threshold: 0.1,
    });

    // Observar cada seccion
    sections.forEach((section) => observer.observe(section));

    // Manejar Clicks en los links de la navegacion
    navItems.forEach((item) => {
      item.addEventListener("click", (event) => {
        event.preventDefault();
        const targetId = item.getAttribute("aria-label");
        const targetSection = document.querySelector(
          `[data-section=${targetId}]`,
        );
        targetSection?.scrollIntoView({ behavior: "smooth" });
      });
    });

    return () => observer.disconnect();
  });
</script>
<style>
  nav {
    animation: nav-shadown 1s linear both;
    animation-timeline: scroll();
    animation-range: 0 100px;
  }

  nav {
    @apply bg-white/15;
  }
  @keyframes nav-shadown {
    0% {
      @apply dark:bg-gray-800/0 bg-white/0;
    }
    to {
      @apply shadow-lg ring-1 backdrop-blur ring-white/10;
    }
  }
</style>
