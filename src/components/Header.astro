---
import { GitHub, Lenguage, LinkedIn } from "../icons";
import ModeToggle from "./ModeToggle.astro";
import TranslateComponent from "./TranslateComponent.astro";

// Definir tipos para los enlaces
interface NavItem {
  title: string;
  label: string;
  url: string;
}

interface SocialLink {
  name: string;
  url: string;
  icon: any;
  iconSize?: number;
}

const navItems: NavItem[] = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
  },
  {
    title: "Sobre mí",
    label: "sobre-mi",
    url: "/#sobre-mi",
  },
];

const socialLinks: SocialLink[] = [
  {
    name: "LinkedIn",
    url: "https://linkedin.com/in/devjuandiego",
    icon: LinkedIn,
    iconSize: 18,
  },
  {
    name: "GitHub",
    url: "https://github.com/juandiego252",
    icon: GitHub,
    iconSize: 18,
  },
];
---

<header
  class="fixed top-0 z-50 w-full bg-[#f5f5f5] dark:bg-[#171717] backdrop-blur-md"
>
  <div class="mx-auto max-w-4xl px-4 py-3 flex items-center justify-between">
    <a
      href="/"
      class="text-md flex items-center space-x-2 font-medium tracking-tight text-white opacity-80 transition-opacity duration-150 hover:opacity-100"
    >
      <span class="text-black dark:text-white">juandiegc.dev</span>
    </a>

    <!-- Navigation links for desktop
    <nav class="hidden md:flex items-center gap-6">
      {
        navItems.map(({ title, url }) => (
          <a
            href={url}
            class="text-sm text-gray-300 hover:text-[#c2ff52] transition-colors duration-300"
          >
            {title}
          </a>
        ))
      }
    </nav> -->

    <div class="md:flex items-center space-x-3">
      {
        socialLinks.map(({ name, url, icon: Icon }) => (
          <a
            href={url}
            title={name}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-9 w-9 items-center justify-center rounded-md dark:text-gray-300 dark:hover:text-white transition-colors duration-300 text-black hover:text-neutral-400"
          >
            <Icon class="h-[18px] w-[18px]" />
          </a>
        ))
      }
      <ModeToggle/>
      <!-- <Lenguage /> s-->
      <TranslateComponent />
    </div>
  </div>
</header>
