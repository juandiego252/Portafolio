---
import { GitHub, LinkedIn } from "../icons";
import ModeToggle from "./ModeToggle.astro";
import TranslateComponent from "./TranslateComponent.astro";

interface SocialLink {
  name: string;
  url: string;
  icon: any;
  iconSize?: number;
}

const socialLinks: SocialLink[] = [
  {
    name: "LinkedIn",
    url: "https://linkedin.com/in/devjuandiego",
    icon: LinkedIn,
    iconSize: 18,
  },
  {
    name: "GitHub",
    url: "https://github.com/juandiego252",
    icon: GitHub,
    iconSize: 18,
  },
];
---

<header
  class="fixed top-0 z-50 w-full bg-[#ffffff] dark:bg-[#1f1f1f] backdrop-blur-md"
>
  <div class="mx-auto max-w-4xl px-4 py-3 flex items-center justify-between">
    <a href="/">
      <span class="text-black dark:text-[#d1cfc0] font-bold tracking-wide"
        >juandiegc.dev</span
      >
    </a>

    <div class="flex items-center">
      <div
        class="flex items-center rounded-full border border-neutral-400/50 dark:border-neutral-700
               bg-white/60 dark:bg-[#1f1f1f] backdrop-blur px-1 py-1"
      >
        <!-- Grupo: Redes sociales -->
        <div class="flex items-center gap-1">
          {
            socialLinks.map(({ name, url, icon: Icon }) => (
              <a
                href={url}
                title={name}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex h-8 w-8 items-center justify-center rounded-full
                       text-neutral-800 dark:text-neutral-300
                       hover:bg-neutral-100 dark:hover:bg-neutral-800
                       hover:text-neutral-600 dark:hover:text-white
                       transition-colors"
              >
                <Icon class="h-4.5 w-4.5" />
              </a>
            ))
          }
        </div>
    
        <!-- Separador vertical -->
        <div class="h-6 w-px bg-neutral-300/60 dark:bg-neutral-700/60 mx-2"></div>
    
        <!-- Grupo: Modo -->
        <div class="flex items-center">
          <ModeToggle />
        </div>
    
        <!-- Separador vertical -->
        <div class="h-6 w-px bg-neutral-300/60 dark:bg-neutral-700/60 mx-2"></div>
    
        <!-- Grupo: Traducción -->
        <div class="flex items-center">
          <TranslateComponent />
        </div>
      </div>
    </div>
  </div>
</header>
