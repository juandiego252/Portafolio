---
import { GitHub, ArrowUpRight } from "./icons";
import Projects from "./Projects.astro";

export interface Props {
  title: string;
  description: string;
  image: string;
  tags: { name: string; class: string; icon: any }[];
  link: string;
  github?: string;
  latest?: boolean;
  updated?: boolean;
  fullstack?: boolean;
}

const {
  title,
  description,
  image,
  tags,
  link,
  github,
  latest = false,
  updated = false,
  fullstack = false,
} = Astro.props;
---

<div
  role="contentinfo"
  id="project-card"
  class="relative flex flex-col rounded-md border-[1px] border-neutral-600 px-3 py-4 shadow-sm w-full h-full"
>
  <!-- Hover effect elements -->
  <input
    aria-hidden="true"
    class="pointer-events-none absolute left-0 top-0 z-10 h-full w-full cursor-default rounded-[0.310rem] border transition-opacity duration-500 placeholder:select-none border-white/50"
    id="hover-border"
    style="opacity: 0; -webkit-mask-image: radial-gradient(30% 30px at 0px 0px, black 45%, transparent); background-color: transparent;"
  />
  <div
    class="pointer-events-none absolute -inset-px rounded-md opacity-0 transition duration-300"
    id="hover-spotlight"
    style="opacity: 0; background: radial-gradient(600px circle at 0px 0px, rgba(97, 97, 97, 0.1), transparent 60%);"
  >
  </div>

  <div class="flex flex-col space-y-3">
    <!-- Header with title and links -->
    <div class="flex w-full items-center justify-between">
      <div class="flex items-center space-x-[10px]">
        {image && <img src={image} alt={title} class="h-6 w-6" />}
        {
          link ? (
            <a
              href={link}
              target="_blank"
              rel="noopener"
              class="group flex items-center gap-[6px] font-medium decoration-neutral-500 decoration-dotted underline-offset-[5px] hover:underline"
            >
              <span>{title}</span>
              <ArrowUpRight class="w-3 h-3 opacity-50 duration-200 group-hover:translate-x-[1.5px] group-hover:opacity-100" />
            </a>
          ) : (
            <p class="font-medium">{title}</p>
          )
        }
      </div>
      <div class="flex items-center gap-2">
        {
          (latest || updated || fullstack) && (
            <div class="flex items-center gap-1.5">
              {fullstack && (
                <span class="animate-shine cursor-default inline-flex items-center justify-center rounded-full border-neutral-800 bg-[linear-gradient(110deg,#171717,45%,#262626,55%,#171717)] bg-[length:200%_100%] px-2 py-0.5 text-[10px] font-medium text-neutral-200 transition-colors">
                  FullStack
                </span>
              )}
              {(latest || updated) && (
                <span class="animate-shine cursor-default inline-flex items-center justify-center rounded-full border-neutral-800 bg-[linear-gradient(110deg,#171717,45%,#262626,55%,#171717)] bg-[length:200%_100%] px-2 py-0.5 text-[10px] font-medium text-neutral-200 transition-colors">
                  {latest ? "latest" : "Updated"}
                </span>
              )}
            </div>
          )
        }
        {
          github && (
            <a
              href={github}
              title={`View ${title} repository on GitHub`}
              target="_blank"
              rel="noopener"
              class="opacity-75 transition-opacity duration-100 hover:opacity-100"
            >
              <GitHub class="w-4 h-4" />
            </a>
          )
        }
      </div>
    </div>

    <!-- Description -->
    <p class="truncate text-sm text-neutral-400">{description}</p>

    <!-- Tags -->
    <div class="flex items-center space-x-1 overflow-y-auto">
      {
        tags.map((tag) => (
          <span
            class={`flex items-center gap-2 px-2 py-1 text-xs rounded-full ${tag.class}`}
          >
            <tag.icon class="w-3.5 h-3.5 flex-shrink-0" />
            <span>{tag.name}</span>
          </span>
        ))
      }
    </div>
  </div>
</div>

<script>
  // Client-side JavaScript for the hover effects
  document.addEventListener("DOMContentLoaded", () => {
    const cards = document.querySelectorAll("#project-card");

    cards.forEach((card) => {
      const hoverBorder = card.querySelector("#hover-border");
      const hoverSpotlight = card.querySelector("#hover-spotlight");
      let focused = false;

      const handleMouseMove = (e: any) => {
        if (!card || focused) return;
        const rect = card.getBoundingClientRect();
        const position = {
          x: e.clientX - rect.left,
          y: e.clientY - rect.top,
        };

        if (hoverBorder) {
          (hoverBorder as HTMLElement).style.webkitMaskImage =
            `radial-gradient(30% 30px at ${position.x}px ${position.y}px, black 45%, transparent)`;
        }

        if (hoverSpotlight) {
          (hoverSpotlight as HTMLElement).style.background =
            `radial-gradient(600px circle at ${position.x}px ${position.y}px, rgba(97, 97, 97, 0.1), transparent 60%)`;
        }
      };

      const handleFocus = () => {
        focused = true;
        if (hoverBorder) (hoverBorder as HTMLElement).style.opacity = "1";
        if (hoverSpotlight) (hoverSpotlight as HTMLElement).style.opacity = "1";
      };

      const handleBlur = () => {
        focused = false;
        if (hoverBorder) (hoverBorder as HTMLElement).style.opacity = "0";
        if (hoverSpotlight) (hoverSpotlight as HTMLElement).style.opacity = "0";
      };

      const handleMouseEnter = () => {
        if (hoverBorder) (hoverBorder as HTMLElement).style.opacity = "1";
        if (hoverSpotlight) (hoverSpotlight as HTMLElement).style.opacity = "1";
      };

      const handleMouseLeave = () => {
        if (hoverBorder) (hoverBorder as HTMLElement).style.opacity = "0";
        if (hoverSpotlight) (hoverSpotlight as HTMLElement).style.opacity = "0";
      };

      card.addEventListener("mousemove", handleMouseMove);
      card.addEventListener("focus", handleFocus);
      card.addEventListener("blur", handleBlur);
      card.addEventListener("mouseenter", handleMouseEnter);
      card.addEventListener("mouseleave", handleMouseLeave);
    });
  });
</script>
