---
import { GitHub, Link } from "./icons";
import Projects from "./Projects.astro";

export interface Props {
    title: string;
    description: string;
    image: string;
    tags: { name: string; class: string; icon: any }[];
    link: string;
    github?: string;
}

const { title, description, image, tags, link, github } = Astro.props;
---

<div class="max-w-sm rounded-lg shadow bg-white/15 border-gray-00 text-white">
    <a href={link} target="_blank" rel="noopener noreferrer">
        <img
            class="rounded-t-lg"
            src={image}
            alt={`Imagen del proyecto ${title}`}
        />
    </a>
    <div class="p-4">
        <h3 class="text-xl font-semibold mb-2">{title}</h3>
        <p class="text-sm text-gray-300 mb-2 text-justify">{description}</p>
        <h4 class="text-wrap font-semibold mb-1 mt-3">Stack</h4>
        <ul class="flex flex-wrap gap-2 mb-4">
            {
                tags.map((tag) => (
                    <li>
                        <span
                            class={`flex items-center gap-2 px-2 py-1 text-xs rounded-full ${tag.class}`}
                        >
                            <tag.icon class="size-4 fill-current" />
                            {tag.name}
                        </span>
                    </li>
                ))
            }
        </ul>
        <div class="flex items-center">
            {
                github && (
                    <a
                        href={github}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center justify-center gap-2 px-3 py-2 text-base transition text-md font-medium text-center group max-w-fit rounded-xl text-white bg-black hover:bg-white hover:text-black border-gray-300"
                    >
                        Code
                        <GitHub class="size-5 ml-2" />
                    </a>
                )
            }
            <a
                href={link}
                target="_blank"
                rel="noopener noreferrer"
                class="ml-2 inline-flex items-center justify-center gap-2 px-3 py-2 text-base transition text-md font-medium text-center group max-w-fit rounded-xl text-white bg-black hover:bg-white hover:text-black border-gray-300"
            >
                Preview
                <Link class="size-4 ml-2" />
            </a>
        </div>
    </div>
</div>
