---
import Badge from "./Badge.astro";
import { GitHub, LinkedIn, Mail, File } from "../icons";
import SocialPill from "./SocialPill.astro";
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <img
      class="rounded-full size-16 shadow-lg"
      src="/public/assets/projects-images/juan-photo.png"
      alt="juand-photo"
    />
    <a
      href="https://www.linkedin.com/in/devjuandiego"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>FullStack Developer!</Badge>
    </a>
  </div>

  <h1 class="text-4xl font-bold tracking-tight text-white sm:text-5xl">
    Juan Diego
  </h1>
  <p
    class="mt-6 text-xl [&>strong]:text-purple-500 [&>strong]:font-semibold text-gray-300 text-pretty"
  >
    Desarrollador FullStack con conocimientos en <strong> C# .NET </strong>
    JavaScript / TypeScript y React, Quito, Ecuador 🟡🔵🔴
  </p>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="">
      <File class="size-5" />
      Ver - CV
    </SocialPill>
    <SocialPill href="mailto:juandiegojd252@gmail.com">
      <Mail class="size-4" />
      juandiego252@gmail.com
    </SocialPill>
  </nav>
</div>
