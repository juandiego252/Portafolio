---
import Badge from "./Badge.astro";
import { Mail, CloudIcon } from "../icons";
import SocialPill from "./SocialPill.astro";
import juanPhoto from "../images/juan-photo.png";
import { Image } from "astro:assets";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import miCv from "../../public/assets/curriculum/Juan_Gualotuña_CV.pdf";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="max-w-xl">
  <div class="flex gap-4 mb-4">
    <Image
      class="rounded-full size-28 md:size-32 shadow-lg border-2 dark:border-[#c2ff52]/30 hover:scale-105 transition-transform duration-300 border-neutral-400"
      src={juanPhoto}
      alt="juand-photo"
    />
    <a
      href="https://www.linkedin.com/in/devjuandiego"
      target="_blank"
      rel="noopener"
      class="flex items-center transition md:justify-center md:hover:scale-105"
    >
      <Badge>{t("profile.badge")}</Badge>
    </a>
  </div>

  <article
    class="py-4 prose-invert prose-a:font-normal prose-a:decoration-neutral-500 prose-a:decoration-dotted prose-a:underline-offset-[5px] prose-a:opacity-80"
  >
    <p class="leading-loose">
      {lang === "en" ? `I'm` : "Soy"}
      <span class="dark:text-[#d1cfc0] font-semibold tracking-wide"
        >Juan Diego</span
      >{t("profile.intro")}
    </p>
  </article>
  <nav class="flex flex-wrap gap-4 mt-8">
    <SocialPill href="mailto:juandiegojd252@gmail.com">
      <Mail class="size-5" />
      juandiego252@gmail.com
    </SocialPill>
    <SocialPill href={miCv} target="_blank" download="JuanGualotuña-CV.pdf">
      <CloudIcon class="size-5" />
      {lang === "en" ? "Resume" : "Curriculum"}
    </SocialPill>
  </nav>
</div>
