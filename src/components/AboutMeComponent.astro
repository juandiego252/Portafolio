---
import { Image } from "astro:assets";
import juanPhotoGhibli from "../images/JuanGhibli.png";
import { getLangFromUrl, useTranslations } from "../i18n/utils";
import { AboutMe } from "../data/aboutme";
import { defaultLanguage } from "../i18n/ui";

const lang = getLangFromUrl(Astro.url);
const localizedAboutMe =
    typeof AboutMe === "object"
        ? AboutMe[lang] || AboutMe[defaultLanguage]
        : AboutMe;
---

<article
    class="flex flex-col items-center justify-center gap-8 dark:text-gray-300 text-gray-600 md:flex-row mt-10"
>
    <div
        class="[&>p]:mb-4 dark:[&>p>strong]:text-[#d0ff0d] [&>p>strong] [&>p>strong]:text-black text-pretty order-2 md:order-1"
        set:html={localizedAboutMe}
    />
    <Image
        alt="JuanDiegoGhibli"
        width="200"
        height="150"
        src={juanPhotoGhibli}
        class="order-1 object-cover w-64 h-full p-1 md:order-2 rotate-3 lg:p-2 lg:w-64 aspect-square rounded-2xl ring-4 dark:ring-white/50 ring-neutral-300"
        style="object-position: 50% 50%"
    />
</article>
